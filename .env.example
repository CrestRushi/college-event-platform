# Backend (copy to backend/.env)
PORT=5000
SERVER_NAME=Server 1
DATABASE_URL=postgresql://postgres:change-me@your-rds-endpoint:5432/college_events
DATABASE_SSL=true
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-college-event-bucket
CORS_ORIGIN=http://localhost:3000

# Frontend (copy applicable line to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5000
